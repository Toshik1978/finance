# Path to the SQLite database holding cached exchange rates.
# Defaults to $HOME/.local/share/finance/finance.db when unset.
FINANCE_DB_PATH=

# AlphaVantage API key. Leave empty to run with Yahoo Finance alone;
# set it to register AlphaVantage as a fallback provider.
# Free tier is 25 requests/day: https://www.alphavantage.co/support/#api-key
FINANCE_ALPHAVANTAGE_KEY=

# Per-request HTTP timeout. Go duration syntax.
FINANCE_HTTP_TIMEOUT=15s
